# ── Anthropic ────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...

# ── Google Gemini ─────────────────────────────────────────────────────────────
GEMINI_API_KEY=AIza...

# ── Databricks (leave blank when USE_MOCK_DB=true) ──────────────────────────
DATABRICKS_HOST=https://<workspace>.azuredatabricks.net
DATABRICKS_TOKEN=dapi...
DATABRICKS_CLUSTER_ID=<cluster-id>
DATABRICKS_WAREHOUSE_ID=<sql-warehouse-id>
DATABRICKS_CATALOG=db_supply_chain_workspace
DATABRICKS_SCHEMA=supply_chain_data

# ── App ──────────────────────────────────────────────────────────────────────
USE_MOCK_DB=true
MOCK_DB_PATH=mock_data/db/supply_chain.duckdb

# ── LangGraph ────────────────────────────────────────────────────────────────
LANGGRAPH_CHECKPOINT_DIR=.checkpoints
